# Copia este archivo como .env.local (nunca se sube al repositorio) y
# rellena los valores desde Supabase → Project Settings → API Keys / Data API.
# No escribas aquí valores reales: este archivo SÍ se sube al repositorio.

# --- Web (local y Vercel) --------------------------------------------------
# URL del proyecto: https://<ref>.supabase.co
SUPABASE_URL=
# Clave publicable (sb_publishable_...) o, en proyectos antiguos, la "anon key".
SUPABASE_PUBLISHABLE_KEY=

# --- Solo en tu ordenador, para crear alumnos (npm run alumnos:crear) -------
# Clave secreta (sb_secret_...) o "service_role". Da control total sobre el
# proyecto: NO la pongas en Vercel ni en ninguna variable NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Solo desarrollo local ---------------------------------------------------
# 1 = vista previa del Área de Alumnos sin iniciar sesión. Ignorada en producción.
ALUMNOS_PREVIEW=
